# انسخ هذا الملف إلى .env.local وضع القيم من لوحة Supabase (Project Settings → API)
# ملاحظة: نستخدم المفتاح العام (anon/publishable) فقط. لا تضع Service Role Key هنا أبدًا.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --------------------------------------------------------------------------
# ما يلي ليس للواجهة: يُستخدم فقط مع scripts/configure-supabase.mjs في جهازك.
# لا تضعه في .env.local ولا في متغيرات Vercel، ولا تسبقه بـ VITE_.
#   OWNER_EMAIL=you@gmail.com          # حساب Google الوحيد المسموح له بالدخول
#   SUPABASE_ACCESS_TOKEN=sbp_...      # Personal Access Token
#   GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=...
# --------------------------------------------------------------------------
